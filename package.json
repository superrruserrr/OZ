{
  "name": "oz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0 && node scripts/check-dependencies.mjs",
    "test": "turbo run generate --output-logs=errors-only && vitest run",
    "test:stories": "pnpm --filter @oz/ui test:stories",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:api": "playwright test --config e2e/api.config.ts",
    "test:e2e:documents": "playwright test --config e2e/documents.config.ts",
    "test:e2e:gdpr": "playwright test --config e2e/gdpr.config.ts",
    "test:e2e:search": "playwright test --config e2e/search.config.ts",
    "test:containers": "scripts/containers-smoke.sh",
    "test:coverage": "turbo run generate --output-logs=errors-only && vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev:up": "node scripts/dev-env.mjs up",
    "dev:down": "node scripts/dev-env.mjs down",
    "dev:reset": "node scripts/dev-env.mjs reset",
    "dev:status": "node scripts/dev-env.mjs status",
    "dev:web": "pnpm --filter @oz/web dev",
    "db:migrate": "pnpm --filter @oz/db db:migrate",
    "db:status": "pnpm --filter @oz/db db:status",
    "db:rollback": "pnpm --filter @oz/db db:rollback",
    "db:seed": "pnpm --filter @oz/db db:seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@oz/auth": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "testcontainers": "^12.2.1",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,yml,yaml,css,md}": "prettier --write --ignore-unknown"
  }
}
