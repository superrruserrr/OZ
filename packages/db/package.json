{
  "name": "@oz/db",
  "version": "0.0.0",
  "private": true,
  "description": "Schéma Prisma, migrations, seeds (lot 0.6)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:load": "vitest run --config vitest.load.config.ts",
    "db:migrate": "turbo run build --filter=@oz/db --output-logs=errors-only && node dist/cli/migrate.js",
    "db:status": "prisma migrate status",
    "db:rollback": "turbo run build --filter=@oz/db --output-logs=errors-only && node dist/cli/rollback.js",
    "db:seed": "turbo run build --filter=@oz/db --output-logs=errors-only && node dist/cli/seed.js",
    "db:anonymize": "turbo run build --filter=@oz/db --output-logs=errors-only && node dist/cli/anonymize.js",
    "db:er": "turbo run build --filter=@oz/db --output-logs=errors-only && node dist/cli/er-diagram.js"
  },
  "devDependencies": {
    "@oz/auth": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.9.1",
    "testcontainers": "^12.2.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@oz/config": "workspace:*",
    "@oz/core": "workspace:*",
    "@oz/testing": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  }
}
