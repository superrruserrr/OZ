// Schéma OZ (TD-002). Conventions : naming_conventions.md (tables snake_case au pluriel, @map),
// migrations : docs/db/migrations.md (chaque migration a son down.sql).
// Contraintes CHECK, déclencheurs, RLS, partitions et fonctions sont dans les migrations SQL (TD-002) :
// Prisma ne les représente pas.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Réglages techniques de la plateforme (table technique minimale du lot 0.6).
model SystemSetting {
  id        String   @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  key       String   @unique
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

// ---------------------------------------------------------------------------------------------
// Socle d'identité (lot 1.1a, EX-101). Colonnes *Encrypted : pgcrypto (oz_encrypt, clé en paramètre) ;
// *Hmac : index aveugle (oz_blind_index). RLS forcée : contexte `oz.user_id` posé par transaction.
// ---------------------------------------------------------------------------------------------

enum UserStatus {
  pending_verification
  active
  suspended
  closed

  @@map("user_status")
}

/// Sept profils d'inscription + administrateur interne (D-K03, D-K10).
enum RoleKind {
  player
  guardian
  academy
  club
  federation
  center
  recruiter
  admin

  @@map("role_kind")
}

enum OrganizationType {
  academy
  club
  federation
  center
  recruiter
  agency

  @@map("organization_type")
}

/// Graphe de vérification du plan §5.4.
enum VerificationStatus {
  declared
  pending
  in_review
  verified
  rejected
  suspended

  @@map("verification_status")
}

enum GuardianRelationship {
  mother
  father
  legal_guardian
  other

  @@map("guardian_relationship")
}

enum ConsentType {
  terms_of_service
  privacy_policy
  guardian_data_processing
  guardian_profile_publication

  @@map("consent_type")
}

enum PlayerPosition {
  goalkeeper
  centre_back
  full_back
  defensive_midfielder
  central_midfielder
  attacking_midfielder
  winger
  striker

  @@map("player_position")
}

enum DominantFoot {
  left
  right
  both

  @@map("dominant_foot")
}

/// Compte technique. Email stocké en minuscules ; suppression physique interdite.
model User {
  id                  String     @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  email               String     @unique
  passwordHash        String?    @map("password_hash")
  status              UserStatus @default(pending_verification)
  totpSecretEncrypted Bytes?     @map("totp_secret_encrypted")
  totpEnabledAt       DateTime?  @map("totp_enabled_at") @db.Timestamptz(6)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  lastSeenAt          DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  roles      UserRole[]  @relation("UserRoleUser")
  sessions   Session[]
  authTokens AuthToken[]
  player     Player?     @relation("PlayerUser")
  guardians  Guardian[]  @relation("GuardianUser")
  consents   Consent[]   @relation("ConsentGrantedByUser")
  auditTrail AuditLog[]

  rolesCreated         UserRole[]     @relation("UserRoleCreatedBy")
  rolesUpdated         UserRole[]     @relation("UserRoleUpdatedBy")
  organizationsCreated Organization[] @relation("OrganizationCreatedBy")
  organizationsUpdated Organization[] @relation("OrganizationUpdatedBy")
  playersCreated       Player[]       @relation("PlayerCreatedBy")
  playersUpdated       Player[]       @relation("PlayerUpdatedBy")
  guardiansCreated     Guardian[]     @relation("GuardianCreatedBy")
  guardiansUpdated     Guardian[]     @relation("GuardianUpdatedBy")
  consentsCreated      Consent[]      @relation("ConsentCreatedBy")
  consentsUpdated      Consent[]      @relation("ConsentUpdatedBy")

  documentsUploaded    Document[]        @relation("DocumentUploadedBy")
  documentsCreated     Document[]        @relation("DocumentCreatedBy")
  documentsUpdated     Document[]        @relation("DocumentUpdatedBy")
  kycDecisions         KycCase[]         @relation("KycCaseDecidedBy")
  kycSecondDecisions   KycCase[]         @relation("KycCaseSecondDecidedBy")
  kycCasesCreated      KycCase[]         @relation("KycCaseCreatedBy")
  kycCasesUpdated      KycCase[]         @relation("KycCaseUpdatedBy")
  kycCaseDocsCreated   KycCaseDocument[]
  importsCreated       Import[]          @relation("ImportCreatedBy")
  importsUpdated       Import[]          @relation("ImportUpdatedBy")
  subscriptionsCreated Subscription[]    @relation("SubscriptionCreatedBy")
  subscriptionsUpdated Subscription[]    @relation("SubscriptionUpdatedBy")
  notifications        Notification[]

  @@map("users")
}

/// Rôle et portée. Un rôle d'organisation exige `organizationId` ; unicité NULLS NOT DISTINCT (SQL).
model UserRole {
  id             String    @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           RoleKind
  organizationId String?   @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  user          User          @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User?         @relation("UserRoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?         @relation("UserRoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([userId, role, organizationId])
  @@index([organizationId])
  @@map("user_roles")
}

/// Session de rafraîchissement : empreinte du jeton seulement, IP tronquée (/24, /48).
model Session {
  id                String    @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  userAgent         String?   @map("user_agent")
  deviceFingerprint String?   @map("device_fingerprint")
  ip                String?   @db.Inet
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

model Organization {
  id                 String             @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  type               OrganizationType
  name               String
  registrationNumber String?            @map("registration_number")
  country            String
  region             String?
  city               String?
  contactEmail       String?            @map("contact_email")
  verificationStatus VerificationStatus @default(declared) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdBy          String?            @map("created_by") @db.Uuid
  updatedBy          String?            @map("updated_by") @db.Uuid
  /// Souscription courante : clé composite, toujours une souscription de cette organisation.
  subscriptionId     String?            @map("subscription_id") @db.Uuid

  members       UserRole[]
  players       Player[]
  createdByUser User?          @relation("OrganizationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?          @relation("OrganizationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  subscription  Subscription?  @relation("OrganizationCurrentSubscription", fields: [subscriptionId, id], references: [id, organizationId], onDelete: Restrict)
  subscriptions Subscription[] @relation("SubscriptionOrganization")
  documents     Document[]
  kycCases      KycCase[]
  imports       Import[]

  @@map("organizations")
}

/// Fiche joueur. Âge minimal 6 ans et OZ ID immuable (déclencheur) ; minorité jamais stockée (CP-15).
model Player {
  id                      String                   @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  userId                  String?                  @unique @map("user_id") @db.Uuid
  ozId                    String?                  @unique @map("oz_id")
  firstName               String                   @map("first_name")
  lastName                String                   @map("last_name")
  birthDate               DateTime                 @map("birth_date") @db.Date
  nationality             String
  country                 String
  region                  String?
  city                    String?
  phoneEncrypted          Bytes?                   @map("phone_encrypted")
  phoneHmac               Bytes?                   @map("phone_hmac")
  documentNumberEncrypted Bytes?                   @map("document_number_encrypted")
  documentNumberHmac      Bytes?                   @map("document_number_hmac")
  primaryPosition         PlayerPosition?          @map("primary_position")
  secondaryPosition       PlayerPosition?          @map("secondary_position")
  dominantFoot            DominantFoot?            @map("dominant_foot")
  heightCm                Int?                     @map("height_cm") @db.SmallInt
  weightKg                Int?                     @map("weight_kg") @db.SmallInt
  verificationStatus      VerificationStatus       @default(declared) @map("verification_status")
  guardianId              String?                  @map("guardian_id") @db.Uuid
  organizationId          String?                  @map("organization_id") @db.Uuid
  visibility              Json                     @default("{}")
  /// Recherche plein texte : colonne générée (SQL), index GIN ; trigrammes sur noms désaccentués.
  searchVector            Unsupported("tsvector")? @default(dbgenerated("oz_player_search_document(first_name, last_name, city, primary_position)")) @map("search_vector")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(6)
  createdBy               String?                  @map("created_by") @db.Uuid
  updatedBy               String?                  @map("updated_by") @db.Uuid

  user          User?         @relation("PlayerUser", fields: [userId], references: [id], onDelete: Restrict)
  guardian      Guardian?     @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consents      Consent[]
  documents     Document[]
  kycCases      KycCase[]
  /// OZ ID réservé à ce joueur par le registre, à lui et à nul autre (lot 1.2).
  ozIdEntry     OzIdRegistry? @relation("PlayerOzId", fields: [ozId, id], references: [ozId, playerId], onDelete: Restrict, map: "players_oz_id_registry_fkey")
  ozIdReserved  OzIdRegistry? @relation("OzIdRegistryPlayer")
  createdByUser User?         @relation("PlayerCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?         @relation("PlayerUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([documentNumberHmac])
  @@index([guardianId])
  @@index([organizationId])
  @@index([searchVector], type: Gin)
  @@map("players")
}

/// Parent ou tuteur légal : contacts et pièce chiffrés.
model Guardian {
  id                      String               @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  userId                  String?              @map("user_id") @db.Uuid
  firstName               String               @map("first_name")
  lastName                String               @map("last_name")
  relationship            GuardianRelationship
  country                 String
  phoneEncrypted          Bytes?               @map("phone_encrypted")
  phoneHmac               Bytes?               @map("phone_hmac")
  emailEncrypted          Bytes?               @map("email_encrypted")
  emailHmac               Bytes?               @map("email_hmac")
  documentNumberEncrypted Bytes?               @map("document_number_encrypted")
  documentNumberHmac      Bytes?               @map("document_number_hmac")
  verificationStatus      VerificationStatus   @default(declared) @map("verification_status")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdBy               String?              @map("created_by") @db.Uuid
  updatedBy               String?              @map("updated_by") @db.Uuid

  user          User?      @relation("GuardianUser", fields: [userId], references: [id], onDelete: Restrict)
  players       Player[]
  consents      Consent[]
  documents     Document[]
  createdByUser User?      @relation("GuardianCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?      @relation("GuardianUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([documentNumberHmac])
  @@index([userId])
  @@map("guardians")
}

/// Registre des consentements : horodatage serveur, immuable, révocation définitive (déclencheur).
model Consent {
  id                  String      @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  type                ConsentType
  textVersion         String      @map("text_version")
  playerId            String?     @map("player_id") @db.Uuid
  grantedByUserId     String?     @map("granted_by_user_id") @db.Uuid
  grantedByGuardianId String?     @map("granted_by_guardian_id") @db.Uuid
  grantedAt           DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt           DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdBy           String?     @map("created_by") @db.Uuid
  updatedBy           String?     @map("updated_by") @db.Uuid

  player            Player?   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  grantedByUser     User?     @relation("ConsentGrantedByUser", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  grantedByGuardian Guardian? @relation(fields: [grantedByGuardianId], references: [id], onDelete: Restrict)
  createdByUser     User?     @relation("ConsentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser     User?     @relation("ConsentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([grantedByGuardianId])
  @@index([grantedByUserId])
  @@index([playerId])
  @@map("consents")
}

/// Journal d'audit (EX-T11) : partitionné par mois (SQL), chaîné par SHA-256 et immuable (déclencheurs).
/// Position et hachages sont calculés par la base : toute valeur fournie est remplacée.
model AuditLog {
  id            String   @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  chainPosition BigInt   @default(0) @map("chain_position")
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  targetType    String   @map("target_type")
  targetId      String?  @map("target_id") @db.Uuid
  reason        String
  requestId     String?  @map("request_id")
  metadata      Json     @default("{}")
  prevHash      Bytes    @default("") @map("prev_hash")
  hash          Bytes    @default("")
  /// Heure de la base : une heure envoyée par le client est refusée par le déclencheur.
  createdAt     DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([id, createdAt])
  @@index([actorUserId])
  @@index([chainPosition])
  @@index([targetType, targetId], map: "audit_log_target_idx")
  @@map("audit_log")
}

/// Tête de la chaîne d'audit : une seule ligne, écrite par le seul déclencheur `oz_audit_chain`.
model AuditChainState {
  id           Boolean @id @default(true)
  lastPosition BigInt  @map("last_position")
  lastHash     Bytes   @map("last_hash")

  @@map("audit_chain_state")
}

// ---------------------------------------------------------------------------------------------
// Dossiers et opérations (lot 1.1b, plan §5.2). Déclencheurs (CP-16), RLS, recherche : SQL.
// ---------------------------------------------------------------------------------------------

enum DocumentType {
  birth_certificate
  identity_document
  photo
  license
  video
  organization_registration

  @@map("document_type")
}

enum AvStatus {
  pending
  clean
  infected
  error

  @@map("av_status")
}

enum KycStatus {
  draft
  submitted
  in_review
  approved
  rejected
  expired

  @@map("kyc_status")
}

enum ImportSource {
  csv
  xlsx

  @@map("import_source")
}

enum ImportStatus {
  pending
  processing
  completed
  failed

  @@map("import_status")
}

enum NotificationChannel {
  email
  sms
  in_app

  @@map("notification_channel")
}

enum NotificationStatus {
  queued
  sent
  failed
  cancelled

  @@map("notification_status")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired

  @@map("subscription_status")
}

enum PaymentProvider {
  stripe
  cinetpay
  manual

  @@map("payment_provider")
}

/// Pièce téléversée : clé de stockage (jamais d'URL), empreinte, statut antivirus, purge datée.
model Document {
  id                      String       @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  type                    DocumentType
  playerId                String?      @map("player_id") @db.Uuid
  guardianId              String?      @map("guardian_id") @db.Uuid
  organizationId          String?      @map("organization_id") @db.Uuid
  uploadedBy              String       @map("uploaded_by") @db.Uuid
  storageKey              String       @unique @map("storage_key")
  mimeType                String       @map("mime_type")
  sizeBytes               BigInt       @map("size_bytes")
  sha256                  String
  avStatus                AvStatus     @default(pending) @map("av_status")
  avCheckedAt             DateTime?    @map("av_checked_at") @db.Timestamptz(6)
  ocrExtractEncrypted     Bytes?       @map("ocr_extract_encrypted")
  documentNumberEncrypted Bytes?       @map("document_number_encrypted")
  documentNumberHmac      Bytes?       @map("document_number_hmac")
  retentionUntil          DateTime     @map("retention_until") @db.Timestamptz(6)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy               String?      @map("created_by") @db.Uuid
  updatedBy               String?      @map("updated_by") @db.Uuid

  player        Player?           @relation(fields: [playerId], references: [id], onDelete: Restrict)
  guardian      Guardian?         @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  organization  Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploader      User              @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)
  createdByUser User?             @relation("DocumentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?             @relation("DocumentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  kycCases      KycCaseDocument[]

  @@index([documentNumberHmac])
  @@index([guardianId])
  @@index([organizationId])
  @@index([playerId])
  @@index([sha256])
  @@index([uploadedBy])
  @@map("documents")
}

/// Dossier de vérification d'un joueur ou d'une organisation (§5.4) ; quatre yeux si sensible (CP-16).
model KycCase {
  id              String    @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  playerId        String?   @map("player_id") @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  level           Int       @db.SmallInt
  status          KycStatus @default(draft)
  checks          Json      @default("[]")
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  decidedBy       String?   @map("decided_by") @db.Uuid
  secondDecidedBy String?   @map("second_decided_by") @db.Uuid
  decisionReason  String?   @map("decision_reason")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  player        Player?           @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organization  Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  decider       User?             @relation("KycCaseDecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict)
  secondDecider User?             @relation("KycCaseSecondDecidedBy", fields: [secondDecidedBy], references: [id], onDelete: Restrict)
  createdByUser User?             @relation("KycCaseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?             @relation("KycCaseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  documents     KycCaseDocument[]

  @@index([organizationId])
  @@index([playerId])
  @@index([status])
  @@map("kyc_cases")
}

/// Pièce jointe à un dossier : elle concerne son sujet ou le tuteur du joueur (déclencheur).
model KycCaseDocument {
  kycCaseId  String   @map("kyc_case_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  kycCase       KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Restrict)
  document      Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdByUser User?    @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@id([kycCaseId, documentId])
  @@index([documentId])
  @@map("kyc_case_documents")
}

/// Import en masse : un import terminé a classé chacune de ses lignes (CP-26).
model Import {
  id             String       @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  source         ImportSource
  fileName       String       @map("file_name")
  fileSha256     String       @map("file_sha256")
  fileStorageKey String?      @map("file_storage_key")
  mapping        Json         @default("{}")
  status         ImportStatus @default(pending)
  rowsTotal      Int          @default(0) @map("rows_total")
  rowsOk         Int          @default(0) @map("rows_ok")
  rowsRejected   Int          @default(0) @map("rows_rejected")
  rowsDuplicate  Int          @default(0) @map("rows_duplicate")
  reportKey      String?      @map("report_key")
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("ImportCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?        @relation("ImportUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("imports")
}

/// Abonnement d'une organisation ; une seule souscription en cours (index unique partiel, SQL).
model Subscription {
  id                String             @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  tier              String             @default("free")
  status            SubscriptionStatus
  provider          PaymentProvider
  providerReference String?            @map("provider_reference")
  periodStart       DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime           @map("period_end") @db.Timestamptz(6)
  quotas            Json               @default("{}")
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdBy         String?            @map("created_by") @db.Uuid
  updatedBy         String?            @map("updated_by") @db.Uuid

  organization  Organization   @relation("SubscriptionOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  currentOf     Organization[] @relation("OrganizationCurrentSubscription")
  createdByUser User?          @relation("SubscriptionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?          @relation("SubscriptionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("subscriptions")
}

/// File et historique des notifications : la charge ne porte que des identifiants (CHECK).
model Notification {
  id              String              @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  channel         NotificationChannel
  template        String
  payload         Json                @default("{}")
  status          NotificationStatus  @default(queued)
  attempts        Int                 @default(0) @db.SmallInt
  lastError       String?             @map("last_error")
  scheduledAt     DateTime            @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt          DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([recipientUserId])
  @@index([status, scheduledAt])
  @@map("notifications")
}

/// Registre des OZ ID émis (lot 1.2, EX-102) : jamais modifié ni supprimé, atteint par oz_issue_oz_id seulement.
/// Contrôle de Damm vérifié en base (oz_ozid_is_valid).
model OzIdRegistry {
  ozId     String   @id @map("oz_id")
  playerId String   @unique @map("player_id") @db.Uuid
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  player  Player   @relation("OzIdRegistryPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  /// Au plus un joueur (players.oz_id est unique) ; Prisma ne sait pas le dire sur une clé composite.
  holders Player[] @relation("PlayerOzId")

  @@unique([ozId, playerId])
  @@map("oz_id_registry")
}

enum AuthTokenPurpose {
  email_verification
  password_reset

  @@map("auth_token_purpose")
}

/// Jeton à usage unique envoyé par email (lot 1.3a) : empreinte SHA-256 seulement. Aucun accès
/// direct : lecture et consommation par les fonctions `oz_auth_*` (chemin privilégié, D-059).
model AuthToken {
  id         String           @id @default(dbgenerated("oz_uuid_v7()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("auth_tokens")
}
