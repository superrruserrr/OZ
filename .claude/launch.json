{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "FEATURE_CONTACT_FORM=true",
        "pnpm",
        "--filter",
        "@oz/api",
        "start"
      ],
      "port": 3001
    },
    {
      "name": "api-auth",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "FEATURE_CONTACT_FORM=true FEATURE_AUTH=true SMTP_HOST=127.0.0.1 AUTH_HMAC_KEY=$(openssl rand -base64 48) JWT_ACCESS_SECRET=$(openssl rand -base64 64 | tr -d '\\n') JWT_REFRESH_SECRET=$(openssl rand -base64 64 | tr -d '\\n') pnpm --filter @oz/api start"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@oz/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@oz/admin",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@oz/ui",
        "storybook"
      ],
      "port": 6006
    }
  ]
}
