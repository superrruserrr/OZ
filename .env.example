# OZ — variables d'environnement (gabarit versionné)
# Copier en .env pour le développement local : `pnpm dev:up` le fait automatiquement s'il manque.
# Règle R8 : aucune valeur secrète ici. Seuls les identifiants des conteneurs locaux (préfixe « oz »)
# ont une valeur ; ils ne servent qu'à docker compose sur le poste et ne sont jamais réutilisés ailleurs.
# Recette et production : valeurs dans le gestionnaire de secrets Scaleway (TD-009), jamais dans un fichier.

# --- Application -------------------------------------------------------------
NODE_ENV=development
# local | preview | staging | production — décide notamment de l'exposition de /docs (lot 0.3)
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
# Origines autorisées par CORS, séparées par des virgules (https obligatoire en production)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Drapeaux (R13), désactivés par défaut. Le formulaire de contact est refusé en production
# tant que la limitation de débit (lot 1.3) et l'envoi d'email (lot 1.15) n'existent pas.
FEATURE_CONTACT_FORM=false
# Comptes (lots 1.3a et 1.3b) : inscription, confirmation d'email, réinitialisation, connexion et
# sessions. Activé, il exige APP_URL, SMTP_*, EMAIL_FROM, AUTH_HMAC_KEY (générer une clé locale :
# openssl rand -base64 32), les deux secrets JWT_* et les deux clés DATABASE_* ci-dessous ; hors local,
# Infobip et Twilio configurés ; en recette et en production, TRUST_PROXY non nul. Reste éteint en production : conditions dans DEBT.md (D-083).
FEATURE_AUTH=false
AUTH_HMAC_KEY=
# Mandataires de confiance devant l'API (lot 1.3ca) : 0 en accès direct (local), 2 derrière
# Cloudflare puis Traefik. Une valeur trop haute laisse un client choisir son IP (X-Forwarded-For).
TRUST_PROXY=0
# reCAPTCHA v3 de l'inscription (lot 1.3ca) : secret serveur exigé hors local ; vide en local =
# vérification sautée. Score minimal d'un humain, de 0 à 1.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- PostgreSQL (conteneur local, infra/docker/compose.dev.yml) --------------
POSTGRES_USER=oz
POSTGRES_PASSWORD=oz
POSTGRES_DB=oz
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oz:oz@localhost:5432/oz
# Recette et production (Secret Manager, lot 0.8b) : migrations par le rôle oz_migrator ; vide = DATABASE_URL
DATABASE_MIGRATION_URL=
# Autorité de l'instance PostgreSQL managée (PEM, « \n » littéraux acceptés) ; exigée hors local (D-006)
DATABASE_CA_CERT=
# Chiffrement colonne pgcrypto et index aveugle (plan §6.9) : 32 caractères au moins, deux clés distinctes,
# propres à chaque environnement (openssl rand -base64 48) ; exigées en recette, en production et dès que FEATURE_AUTH=true (secret TOTP, lot 1.3cb) ; sinon facultatives en local.
DATABASE_ENCRYPTION_KEY=
DATABASE_BLIND_INDEX_KEY=

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Autorité du cluster Redis managé (PEM) ; exigée hors local, avec une URL rediss:// (D-006)
REDIS_CA_CERT=

# --- Authentification (§6.2) -------------------------------------------------
# 64 octets aléatoires par environnement, jamais réutilisés (openssl rand -base64 64), et distincts :
# ACCESS signe le jeton d'accès (HS256) ; REFRESH empreinte le jeton de rafraîchissement en base
# (le changer invalide toutes les sessions). Accès : 15m, fixe. Rafraîchissement : 1d à 30d,
# glissant, plafonné à 90 jours par famille de sessions (lot 1.3b).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY=19456

# --- Stockage objets (TD-010) — SeaweedFS en local, Scaleway Object Storage ailleurs ---
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=fr-par
S3_BUCKET=oz-documents
S3_ACCESS_KEY=oz-dev-access
S3_SECRET_KEY=oz-dev-secret
SIGNED_URL_TTL=300

# --- Antivirus ---------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Anti-bot ----------------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Email (TD-011) — Mailpit en local (SMTP 1025, interface http://localhost:8025) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Identifiants SMTP (Scaleway TEM en recette et en production, D2 du lot 1.3a) ; vides pour Mailpit.
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025
SCW_TEM_PROJECT_ID=
SCW_TEM_SECRET_KEY=
SCW_TEM_REGION=fr-par
EMAIL_FROM=OZ <no-reply@oz.localhost>

# --- SMS / OTP (TD-012) — fournisseur factice en local ---------------------------
# fake : code écrit sur la sortie standard, refusé hors local. Sinon infobip + secours twilio.
SMS_PROVIDER_PRIMARY=fake
SMS_PROVIDER_FALLBACK=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=OZ
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WHATSAPP_TEMPLATE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Indicatifs complets acceptés, séparés par des virgules : parade au pompage de SMS.
SMS_ALLOWED_PREFIXES=+237

# --- Paiements (TD-013, Phase 2) ---------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOBILE_MONEY_PROVIDER=cinetpay
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=

# --- Observabilité (TD-014) --------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- KYC (§7, TD-015, TD-016) ------------------------------------------------
# Fournisseur choisi au lot 1.10 après POC (veriff | smile-id)
IDENTITY_VERIFIER_PROVIDER=
IDENTITY_VERIFIER_API_KEY=
IDENTITY_VERIFIER_WEBHOOK_SECRET=
KYC_AUTO_APPROVE_THRESHOLD=25
KYC_AUTO_REJECT_THRESHOLD=70
# Ne jamais passer à false (§7.4, règle des quatre yeux)
KYC_MINOR_REQUIRES_DUAL_APPROVAL=true
# Inactif au lancement ; activation seulement après preuve mesurée et ADR (TD-016)
FEATURE_KYC_AUTO_APPROVE_ADULTS=false
DOCUMENT_RETENTION_DAYS=90
